/**
 * @file todo_dialog.rc
 * @brief TODO task list + sync settings dialogs.
 */
#include "resource.h"
#include <windows.h>

IDD_TODO_LIST_DIALOG DIALOGEX 0, 0, 440, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "TODO"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT       "Source:", IDC_STATIC, 8, 8, 40, 10
    COMBOBOX    IDC_TODO_FILTER_SOURCE, 50, 6, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Importance:", IDC_STATIC, 138, 8, 52, 10
    COMBOBOX    IDC_TODO_FILTER_IMPORTANCE, 192, 6, 80, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL     "Show done", IDC_TODO_SHOW_DONE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 280, 6, 70, 12
    PUSHBUTTON  "Sync", IDC_TODO_SYNC_NOW_BTN, 358, 4, 40, 14
    PUSHBUTTON  "Settings", IDC_TODO_SETTINGS_BTN, 400, 4, 32, 14
    LTEXT       "Due:", IDC_STATIC, 8, 26, 24, 10
    EDITTEXT    IDC_TODO_FILTER_DUE_FROM, 34, 24, 64, 12, ES_AUTOHSCROLL
    EDITTEXT    IDC_TODO_FILTER_DUE_TO, 102, 24, 64, 12, ES_AUTOHSCROLL
    LTEXT       "Done:", IDC_STATIC, 172, 26, 26, 10
    EDITTEXT    IDC_TODO_FILTER_DONE_FROM, 200, 24, 64, 12, ES_AUTOHSCROLL
    EDITTEXT    IDC_TODO_FILTER_DONE_TO, 268, 24, 64, 12, ES_AUTOHSCROLL
    EDITTEXT    IDC_TODO_FILTER_KEYWORD, 338, 24, 94, 12, ES_AUTOHSCROLL
    LISTBOX     IDC_TODO_LIST_VIEW, 8, 42, 424, 210, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    EDITTEXT    IDC_TODO_NEW_EDIT, 8, 258, 200, 12, ES_AUTOHSCROLL
    EDITTEXT    IDC_TODO_NEW_DUE, 212, 258, 64, 12, ES_AUTOHSCROLL
    COMBOBOX    IDC_TODO_NEW_IMPORTANCE, 280, 258, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Add", IDC_TODO_ADD_BUTTON, 344, 256, 40, 14
    PUSHBUTTON  "Done", IDC_TODO_DONE_BUTTON, 8, 276, 50, 14
    PUSHBUTTON  "Delete", IDC_TODO_DELETE_BUTTON, 62, 276, 50, 14
    PUSHBUTTON  "Pin", IDC_TODO_PIN_BUTTON, 116, 276, 50, 14
    PUSHBUTTON  "Close", IDCANCEL, 382, 276, 50, 14
    DEFPUSHBUTTON "OK", IDOK, 382, 296, 50, 14
END

IDD_TODO_SETTINGS_DIALOG DIALOGEX 0, 0, 300, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TODO Settings"
FONT 9, "Microsoft YaHei UI"
BEGIN
    CONTROL     "Enable sync (tweek backend)", IDC_TODO_SYNC_ENABLE, "Button",
                BS_AUTOCHECKBOX | WS_TABSTOP, 10, 10, 200, 12
    LTEXT       "Server URL:", IDC_STATIC, 10, 30, 60, 10
    EDITTEXT    IDC_TODO_SYNC_URL, 10, 42, 280, 12, ES_AUTOHSCROLL
    LTEXT       "Token:", IDC_STATIC, 10, 60, 60, 10
    EDITTEXT    IDC_TODO_SYNC_TOKEN, 10, 72, 280, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT       "Poll interval (15-600s):", IDC_STATIC, 10, 92, 120, 10
    EDITTEXT    IDC_TODO_SYNC_POLL, 10, 104, 60, 12, ES_NUMBER
    PUSHBUTTON  "Sync Now", IDC_TODO_SETTINGS_SYNC_BTN, 80, 104, 60, 14
    DEFPUSHBUTTON "OK", IDOK, 180, 148, 50, 14
    PUSHBUTTON  "Cancel", IDCANCEL, 240, 148, 50, 14
END
