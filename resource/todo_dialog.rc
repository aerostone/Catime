/**
 * @file todo_dialog.rc
 * @brief TODO task list + sync settings dialogs.
 *
 * Layout contracts (dialog units, 96-DPI base):
 * - list dialog 470x330: filter row y=2..40 split into two GROUPBOXes
 *   (time scope x=4..254, state/search x=258..466) so no label overlaps an
 *   input; task list y=46..252; add row y=256..270; action row y=278..292;
 *   board row y=299..313: Board combo + ... manage menu + Sticky
 *   toggle (Close right-aligned at x=412).
 * - boards dialog 300x250: task-book list + New/Rename/Del/Show +
 *   sync status + Sync Now + Settings (RD3).
 * - settings dialog 300x232: sync GROUPBOX y=4..142, sticky GROUPBOX
 *   y=146..204, buttons y=210..224. UiDebug dump tags: "todo-list"/"todo-settings".
 */
#include "resource.h"
#include <windows.h>

IDD_TODO_LIST_DIALOG DIALOGEX 0, 0, 470, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "TODO"
FONT 9, "Microsoft YaHei UI"
BEGIN
    GROUPBOX    "Time range", IDC_TODO_GROUP_TIME, 4, 2, 250, 38
    LTEXT       "Scope:", CLOCK_IDC_STATIC, 10, 16, 30, 10
    COMBOBOX    IDC_TODO_FILTER_DUE_SCOPE, 42, 14, 62, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT    IDC_TODO_FILTER_DUE_FROM, 108, 14, 64, 12, ES_AUTOHSCROLL
    EDITTEXT    IDC_TODO_FILTER_DUE_TO, 176, 14, 64, 12, ES_AUTOHSCROLL
    GROUPBOX    "State && search", IDC_TODO_GROUP_STATE, 258, 2, 208, 38
    COMBOBOX    IDC_TODO_FILTER_SOURCE, 264, 14, 62, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX    IDC_TODO_FILTER_IMPORTANCE, 330, 14, 62, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL     "Done", IDC_TODO_SHOW_DONE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 396, 14, 56, 12
    EDITTEXT    IDC_TODO_FILTER_KEYWORD, 264, 28, 128, 11, ES_AUTOHSCROLL
    EDITTEXT    IDC_TODO_FILTER_DONE_FROM, 396, 28, 0, 0, ES_AUTOHSCROLL | NOT WS_VISIBLE
    EDITTEXT    IDC_TODO_FILTER_DONE_TO, 396, 28, 0, 0, ES_AUTOHSCROLL | NOT WS_VISIBLE
    LISTBOX     IDC_TODO_LIST_VIEW, 8, 46, 454, 206, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    EDITTEXT    IDC_TODO_NEW_EDIT, 8, 258, 200, 12, ES_AUTOHSCROLL
    CONTROL     "", IDC_TODO_NEW_DUE, "SysDateTimePick32",
                DTS_SHORTDATECENTURYFORMAT | DTS_SHOWNONE | WS_TABSTOP,
                212, 256, 84, 14
    COMBOBOX    IDC_TODO_NEW_IMPORTANCE, 280, 258, 60, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "Add", IDC_TODO_ADD_BUTTON, 344, 256, 40, 14
    PUSHBUTTON  "Done", IDC_TODO_DONE_BUTTON, 8, 278, 50, 14
    PUSHBUTTON  "Delete", IDC_TODO_DELETE_BUTTON, 62, 278, 50, 14
    PUSHBUTTON  "Save", IDC_TODO_SAVE_BUTTON, 116, 278, 50, 14
    PUSHBUTTON  "Sync now", IDC_TODO_SYNC_NOW_BTN, 170, 278, 70, 14
    PUSHBUTTON  "Settings...", IDC_TODO_SETTINGS_BTN, 244, 278, 64, 14
    LTEXT       "Board:", CLOCK_IDC_STATIC, 8, 304, 28, 10
    COMBOBOX    IDC_TODO_BOARD_SEL, 38, 300, 150, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON  "...", IDC_TODO_BOARD_MORE, 192, 299, 30, 13
    PUSHBUTTON  "Sticky", IDC_TODO_BOARD_SHOW, 226, 299, 50, 13
    PUSHBUTTON  "Close", IDCANCEL, 412, 299, 50, 14
END

IDD_TODO_BOARDS_DIALOG DIALOGEX 0, 0, 300, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TODO"
FONT 9, "Microsoft YaHei UI"
BEGIN
    GROUPBOX    "Task books", IDC_TODO_GROUP_STATE, 4, 4, 292, 150
    LISTBOX     IDC_TODO_BOOKS_LIST, 10, 18, 180, 98, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON  "New", IDC_TODO_BOOK_NEW, 196, 18, 94, 14
    PUSHBUTTON  "Rename", IDC_TODO_BOOK_RENAME, 196, 36, 94, 14
    PUSHBUTTON  "Del", IDC_TODO_BOOK_DEL, 196, 54, 94, 14
    PUSHBUTTON  "Show panel", IDC_TODO_BOOK_SHOW, 196, 76, 94, 14
    LTEXT       "", IDC_TODO_BOOK_STATUS, 10, 120, 280, 14
    PUSHBUTTON  "Sync Now", IDC_TODO_BOOK_SYNC_NOW, 10, 136, 70, 14
    PUSHBUTTON  "Settings...", IDC_TODO_BOOK_SETTINGS, 86, 136, 70, 14
    DEFPUSHBUTTON "Close", IDOK, 240, 228, 50, 14
END

IDD_TODO_SETTINGS_DIALOG DIALOGEX 0, 0, 300, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TODO Settings"
FONT 9, "Microsoft YaHei UI"
BEGIN
    GROUPBOX    "Sync (tweek)", IDC_TODO_GROUP_SYNC, 4, 4, 292, 138
    CONTROL     "Enable sync (tweek backend)", IDC_TODO_SYNC_ENABLE, "Button",
                BS_AUTOCHECKBOX | WS_TABSTOP, 10, 18, 200, 12
    LTEXT       "Server URL:", CLOCK_IDC_STATIC, 10, 34, 60, 10
    EDITTEXT    IDC_TODO_SYNC_URL, 10, 46, 280, 12, ES_AUTOHSCROLL
    LTEXT       "Token:", CLOCK_IDC_STATIC, 10, 62, 60, 10
    EDITTEXT    IDC_TODO_SYNC_TOKEN, 10, 74, 280, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT       "Poll interval (15-600s):", CLOCK_IDC_STATIC, 10, 92, 120, 10
    EDITTEXT    IDC_TODO_SYNC_POLL, 10, 104, 60, 12, ES_NUMBER
    PUSHBUTTON  "Sync Now", IDC_TODO_SETTINGS_SYNC_BTN, 80, 104, 60, 14
    LTEXT       "", IDC_TODO_SYNC_STATUS, 150, 104, 140, 14
    PUSHBUTTON  "Conflicts...", IDC_TODO_CONFLICT_BTN, 150, 120, 70, 14
    GROUPBOX    "TODO panels", IDC_TODO_GROUP_STICKY, 4, 146, 292, 58
    CONTROL     "Stay on top by default", IDC_TODO_STICKY_TOPMOST, "Button",
                BS_AUTOCHECKBOX | WS_TABSTOP, 10, 158, 160, 12
    CONTROL     "UI debug overlay", IDC_TODO_DEBUG_CHECK, "Button",
                BS_AUTOCHECKBOX | WS_TABSTOP, 180, 158, 100, 12
    LTEXT       "Opacity:", CLOCK_IDC_STATIC, 10, 178, 46, 10
    COMBOBOX    IDC_TODO_STICKY_OPACITY, 60, 175, 70, 80,
                CBS_DROPDOWNLIST | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 180, 210, 50, 14
    PUSHBUTTON  "Cancel", IDCANCEL, 240, 210, 50, 14
END
